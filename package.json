{
  "name": "@hackersandwizards/mail",
  "version": "1.2.5",
  "private": true,
  "description": "The hackers&wizards mail engine: React Email components on the brand tokens, a render command writing the HTML and plain-text parts of a mail from a data file.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./render": "./scripts/render.ts",
    "./components/*": "./components/*.tsx",
    "./theme": "./components/theme.ts",
    "./mails/*": "./mails/*.tsx"
  },
  "bin": {
    "mail-render": "scripts/render.ts"
  },
  "files": [
    "components",
    "mails",
    "scripts/render.ts",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "cd catalog && bun --bun astro build",
    "check": "scaffolding check",
    "check:elements": "CATALOG_FILE=1 bun run build && brand-elements",
    "check:colours": "brand-colours",
    "check:frames": "bun run build && bun scripts/check-frames.ts",
    "check:retired": "bun run build && brand-retired dist",
    "check:copies": "brand-copies",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=1.16.0"
  },
  "devDependencies": {
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.8.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.19.2",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v2.11.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "admin": {
    "designSystem": "https://hackersandwizards.github.io/mail/"
  },
  "scaffolding": {
    "test": "test",
    "check": [
      [
        "check:colours",
        "check:copies"
      ],
      "check:elements",
      "check:frames",
      "check:retired"
    ]
  }
}
