{
  "name": "@hackersandwizards/mail",
  "version": "2.0.12",
  "private": true,
  "description": "The hackers&wizards mail engine: React Email components on the brand tokens, a render command writing the HTML and plain-text parts of a mail from a data file.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./render": "./scripts/render.ts",
    "./components/*": "./components/*.tsx",
    "./theme": "./components/theme.ts",
    "./mails/*": "./mails/*.tsx"
  },
  "bin": {
    "mail-render": "scripts/render.ts"
  },
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "check-lock sh -c 'cd catalog && bun --bun astro build'",
    "check": "scaffolding check",
    "check:elements": "check-lock brand-elements",
    "check:colours": "brand-colours",
    "check:frames": "check-lock bun scripts/check-frames.ts",
    "check:retired": "check-lock brand-retired dist",
    "check:copies": "brand-copies",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test --timeout ${SCAFFOLDING_TEST_TIMEOUT_MS:-5000}"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.11"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=2.11.0"
  },
  "devDependencies": {
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.37.3",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v2.23.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.24.2",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.11",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.0",
    "puppeteer-core": "25.17.0",
    "stylelint": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "admin": {
    "designSystem": "https://hackersandwizards.github.io/mail/catalog/",
    "label": "Mail engine"
  },
  "scaffolding": {
    "test": "test",
    "check": [
      [
        "check:colours",
        "check:copies"
      ],
      "check:elements",
      "check:frames",
      "check:retired"
    ]
  },
  "overrides": {
    "minimatch": "11.0.7"
  }
}
