{
  "name": "@hackersandwizards/mail",
  "version": "1.2.15",
  "private": true,
  "description": "The hackers&wizards mail engine: React Email components on the brand tokens, a render command writing the HTML and plain-text parts of a mail from a data file.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./render": "./scripts/render.ts",
    "./components/*": "./components/*.tsx",
    "./theme": "./components/theme.ts",
    "./mails/*": "./mails/*.tsx"
  },
  "bin": {
    "mail-render": "scripts/render.ts"
  },
  "files": [
    "components",
    "mails",
    "scripts/render.ts",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "check-lock sh -c 'cd catalog && bun --bun astro build'",
    "check": "scaffolding check",
    "check:elements": "check-lock sh -c 'CATALOG_FILE=1 bun run build && brand-elements'",
    "check:colours": "brand-colours",
    "check:frames": "check-lock sh -c 'bun run build && bun scripts/check-frames.ts'",
    "check:retired": "check-lock sh -c 'bun run build && brand-retired dist'",
    "check:copies": "brand-copies",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.8"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=1.16.0"
  },
  "devDependencies": {
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.20.0",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.62.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.3.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.7",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "stylelint": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "admin": {
    "designSystem": "https://hackersandwizards.github.io/mail/catalog/"
  },
  "scaffolding": {
    "test": "test",
    "check": [
      [
        "check:colours",
        "check:copies"
      ],
      "check:elements",
      "check:frames",
      "check:retired"
    ]
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
