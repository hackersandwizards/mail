{
  "name": "@hackersandwizards/mail",
  "version": "0.1.0",
  "private": true,
  "description": "The hackers&wizards mail engine: React Email components on the brand tokens, a render command writing the HTML and plain-text parts of a mail from a data file.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./render": "./scripts/render.ts",
    "./components/*": "./components/*.tsx",
    "./theme": "./components/theme.ts",
    "./mails/*": "./mails/*.tsx"
  },
  "bin": {
    "mail-render": "scripts/render.ts"
  },
  "files": [
    "components",
    "mails",
    "scripts/render.ts",
    "specimen",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun test && bun scripts/specimen.ts --check && bun run design-system:build && brand-colours",
    "lint": "bun --bun eslint --cache --concurrency=auto .",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "specimen": "bun scripts/specimen.ts",
    "dev": "bun --bun astro dev",
    "design-system:build": "bun --bun astro build",
    "check:staged": "bun .claude/skills/engineering/check-staged.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.27.14",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
