{
  "name": "@hackersandwizards/mail",
  "version": "0.3.0",
  "private": true,
  "description": "The hackers&wizards mail engine: React Email components on the brand tokens, a render command writing the HTML and plain-text parts of a mail from a data file.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./render": "./scripts/render.ts",
    "./components/*": "./components/*.tsx",
    "./theme": "./components/theme.ts",
    "./mails/*": "./mails/*.tsx"
  },
  "bin": {
    "mail-render": "scripts/render.ts"
  },
  "files": [
    "components",
    "mails",
    "scripts/render.ts",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node scripts/repo/only-bun.cjs",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "cd catalog && bun --bun astro build",
    "check": "scaffolding check",
    "check:elements": "CATALOG_FILE=1 bun run build && brand-elements",
    "check:colours": "brand-colours",
    "check:admin": "admin-check",
    "check:staged": "check-staged",
    "lint": "bun --bun eslint --cache --concurrency=auto .",
    "typecheck": "bun --bun tsc --noEmit",
    "format:check": "bun --bun prettier --check .",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v0.4.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.30.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v0.3.2",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "scaffolding": {
    "test": "test",
    "check": [
      "check:colours",
      "check:elements",
      "check:admin"
    ]
  }
}
