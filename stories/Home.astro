---
// The design system's home in brand's catalogue shape (AstrobookHome, decision catalogue-shape):
// the header, the rail with the groups, a tile per mail and part drawing its first state. The
// default slot holds the foundations: the colour roles and font stacks a mail paints with, from
// theme.ts, and a tile per brand element this page uses, which brand-elements measures in
// `bun run check`. The mails themselves inline every value and wear no brand element.
import modules from "virtual:astrobook/story-modules.mjs";
import config from "virtual:astrobook/global-config.mjs";
import AstrobookHome from "@hackersandwizards/brand/expert/components/AstrobookHome.astro";
import "@hackersandwizards/brand/disclosure.css";
import pkg from "../package.json";
import elements from "../brand-elements.json";
import { fonts, palette, type Role } from "../components/theme";

// The brand version the tiles name, from the pin: brand-elements fails on any other.
const version = pkg.devDependencies["@hackersandwizards/brand"].split("#v")[1];
const CATALOGUE = "https://hackersandwizards.github.io/brand/catalogue.html";
const notes: Record<string, string> = {
  card: "A tile per mail and part on this page.",
  pill: "The count of states on a tile.",
  table: "The colour roles and font stacks below.",
};
const roles = Object.keys(palette.light) as Role[];
// Astrobook lists a module's states by name, so Dark and Blocked come first; a tile draws the mail
// as sent, light with its images loaded.
const sent = (id: string) => (/\/(light|loaded)$/.test(id) ? 0 : 1);
const shown = modules.map((m) => ({
  ...m,
  stories: [...m.stories].sort((a, b) => sent(a.id) - sent(b.id)),
}));
---

<AstrobookHome
  modules={shown}
  config={config}
  product="Mail"
  title="Design system"
  lead="Every mail and building block of the mail engine, rendered to the HTML a mail client receives and shown in a 600 px frame. Each tile opens its light and dark states; the data is made up."
  source="mail stories"
  groupOrder={["Mails", "Parts"]}
  previewSize={[602, 400]}
>
  <details class="hw-disclosure foundations">
    <summary>
      Foundations: {roles.length} colour roles, 2 font stacks, {elements.uses.length} elements from brand
    </summary>
    <table class="hw-table">
      <thead>
        <tr><th>Role</th><th>Light</th><th>Dark</th></tr>
      </thead>
      <tbody>
        {
          roles.map((role) => (
            <tr>
              <td>{role}</td>
              {(["light", "dark"] as const).map((mode) => (
                <td>
                  <span class="swatch" style={`background:${palette[mode][role]}`} />
                  <code>{palette[mode][role]}</code>
                </td>
              ))}
            </tr>
          ))
        }
        <tr><td>mono</td><td colspan="2"><code>{fonts.mono}</code></td></tr>
        <tr><td>sans</td><td colspan="2"><code>{fonts.sans}</code></td></tr>
      </tbody>
    </table>
    <div class="tiles">
      {
        elements.uses.map((name) => (
          <div data-hw-tile={name} data-hw-version={version}>
            <p>
              aus brand v{version} · <code>hw-{name}</code> ·{" "}
              <a class="hw-link" href={`${CATALOGUE}#hw-${name}`}>catalogue</a>
            </p>
            <p class="note">{notes[name]}</p>
            {name === "card" && <div class="hw-card">Brief</div>}
            {name === "pill" && <span class="hw-pill" data-tone="neutral">4 states</span>}
            {name === "table" && (
              <table class="hw-table">
                <tbody>
                  <tr><td>accent</td><td><code>teal</code></td></tr>
                </tbody>
              </table>
            )}
            {name === "link" && (
              <p>See <a class="hw-link" href="#">the brand catalogue</a> first.</p>
            )}
          </div>
        ))
      }
    </div>
  </details>
</AstrobookHome>

<style>
  .foundations {
    margin-top: 1.5rem;
    font-size: var(--text-ui);
  }
  .foundations > table {
    margin-top: 0.75rem;
  }
  .swatch {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.5em;
    vertical-align: -0.15em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .tiles p {
    margin: 0 0 0.5rem;
  }
  .note {
    color: var(--color-muted);
  }
</style>
