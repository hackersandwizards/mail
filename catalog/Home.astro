---
// The brand elements here are the catalog's own: the mails inline every value and wear none.
import Element from "@hackersandwizards/brand/Element.astro";
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import elements from "../brand-elements.json";
import { fonts, palette, roles } from "../components/theme";

const notes: Record<string, string> = {
  card: "A tile per mail and part on this page.",
  pill: "The count of states on a tile.",
  table: "The colour roles and font stacks above.",
  link: "The brand catalog link on each tile.",
  label: "The colour of an item's label in a mail.",
};
---

<Home>
  <table class="hw-table">
    <thead>
      <tr>
        <th>Role</th>
        <th>Light</th>
        <th>Dark</th>
      </tr>
    </thead>
    <tbody>
      {roles.map((role) => (
        <tr>
          <td>{role}</td>
          {(["light", "dark"] as const).map((mode) => (
            <td>
              <span class="swatch" style={`background:${palette[mode][role]}`} />
              <code>{palette[mode][role]}</code>
            </td>
          ))}
        </tr>
      ))}
      <tr>
        <td>mono</td>
        <td colspan="2">
          <code>{fonts.mono}</code>
        </td>
      </tr>
      <tr>
        <td>sans</td>
        <td colspan="2">
          <code>{fonts.sans}</code>
        </td>
      </tr>
    </tbody>
  </table>
  <div class="tiles">
    {elements.uses.map((name) => (
      <Element name={name} scale="dense" note={notes[name]} />
    ))}
  </div>
</Home>

<style>
  .swatch {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.5em;
    vertical-align: -0.15em;
    border: 1px solid var(--color-border);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
