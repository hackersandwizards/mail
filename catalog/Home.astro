---
// The brand elements here are the catalog's own: the mails inline every value and wear none, the
// label's colour read out of brand's label element (components/theme.ts).
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import "@hackersandwizards/brand/disclosure.css";
import { version } from "@hackersandwizards/brand/package.json";
import elements from "../brand-elements.json";
import { fonts, palette, type Role } from "../components/theme";

const CATALOGUE = "https://hackersandwizards.github.io/brand/catalogue.html";
const notes: Record<string, string> = {
  card: "A tile per mail and part on this page.",
  pill: "The count of states on a tile.",
  table: "The colour roles and font stacks below.",
  link: "The catalogue link on each tile.",
  label: "The colour of an item's label in a mail.",
};
const roles = Object.keys(palette.light) as Role[];
---

<Home>
  <details class="hw-disclosure foundations">
    <summary>
      Foundations: {roles.length} colour roles, 2 font stacks, {elements.uses.length} elements from
      brand
    </summary>
    <table class="hw-table">
      <thead>
        <tr>
          <th>Role</th>
          <th>Light</th>
          <th>Dark</th>
        </tr>
      </thead>
      <tbody>
        {roles.map((role) => (
          <tr>
            <td>{role}</td>
            {(["light", "dark"] as const).map((mode) => (
              <td>
                <span class="swatch" style={`background:${palette[mode][role]}`} />
                <code>{palette[mode][role]}</code>
              </td>
            ))}
          </tr>
        ))}
        <tr>
          <td>mono</td>
          <td colspan="2">
            <code>{fonts.mono}</code>
          </td>
        </tr>
        <tr>
          <td>sans</td>
          <td colspan="2">
            <code>{fonts.sans}</code>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="tiles">
      {elements.uses.map((name) => (
        <div data-hw-tile={name} data-hw-version={version}>
          <p>
            from brand v{version} · <code>hw-{name}</code> ·{" "}
            <a class="hw-link" href={`${CATALOGUE}#hw-${name}`}>
              catalogue
            </a>
          </p>
          <p class="note">{notes[name]}</p>
          {name === "card" && <div class="hw-card">Brief</div>}
          {name === "pill" && (
            <span class="hw-pill" data-tone="neutral">
              4 states
            </span>
          )}
          {name === "table" && (
            <table class="hw-table">
              <tbody>
                <tr>
                  <td>accent</td>
                  <td>
                    <code>teal</code>
                  </td>
                </tr>
              </tbody>
            </table>
          )}
          {name === "label" && <span class="hw-label">Artikel</span>}
          {name === "link" && (
            <p>
              See{" "}
              <a class="hw-link" href={CATALOGUE}>
                the brand catalogue
              </a>{" "}
              first.
            </p>
          )}
        </div>
      ))}
    </div>
  </details>
</Home>

<style>
  .foundations {
    margin-top: 1.5rem;
    font-size: var(--text-ui);
  }
  .foundations > table {
    margin-top: 0.75rem;
  }
  .swatch {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 0.5em;
    vertical-align: -0.15em;
    border: 1px solid var(--color-border);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .tiles p {
    margin: 0 0 0.5rem;
  }
  .note {
    color: var(--color-muted);
  }
</style>
