---
// Every mail type side by side: light, dark as Apple Mail shows it, forced inversion and a phone,
// each with its data file, HTML part and text part. Dark and inversion are browser
// approximations, not real clients.
import "@hackersandwizards/brand/tokens.root.css";
import favicon from "@hackersandwizards/brand/logos/favicon.svg";
import { mails } from "../../mails";
import { forceDark, forceInvert } from "../../../scripts/modes";

const grow = "this.style.height=this.contentDocument.documentElement.scrollHeight+'px'";
const panels = (html: string) => [
  ["hell, 600 px", 600, html],
  ["dunkel wie Apple Mail, 600 px", 600, forceDark(html)],
  ["erzwungene Umkehrung, 600 px", 600, forceInvert(html)],
  ["Telefon, 390 px", 390, html],
] as const;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Mail-Engine: Mailtypen</title>
    <link rel="icon" href={favicon.src} />
  </head>
  <body>
    <h1>Mail-Engine</h1>
    <p>
      Jede Mail aus <code>catalog/mails/*.json</code>,
      gerendert wie mit <code>bun run mail-render</code>. Alle Daten sind erfunden. Dunkel und
      Umkehrung sind Näherungen im Browser, keine echten Clients.
    </p>
    {
      mails.map((m) => (
        <section>
          <h2>{m.data.subject}</h2>
          <p>
            <a href={`${m.base}.json`}>Daten</a> · <a href={`${m.base}.html`}>HTML-Teil</a> ·{" "}
            <a href={`${m.base}.txt`}>Textteil</a> · {Math.round(m.html.length / 100) / 10} KB
          </p>
          <div class="row">
            {panels(m.html).map(([label, width, html]) => (
              <figure>
                <figcaption>{label}</figcaption>
                <iframe title={label} width={width} srcdoc={html} onload={grow} />
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--space-8, 2rem);
    font-family: var(--font-sans);
    color: var(--color-ink);
    background: var(--color-bg);
  }
  h1 {
    font-family: var(--font-mono);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }
  figure {
    margin: 0;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  iframe {
    border: 1px solid var(--color-border);
    background: var(--color-white);
    height: 900px;
  }
  a {
    color: var(--color-teal);
  }
</style>
