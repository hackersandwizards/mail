---
// One rendered mail in a frame at a reading-pane width, grown to the mail's height.
interface Props {
  html: string;
  width: number;
}
const { html, width } = Astro.props;
// A mail's data names its images relative to the mail's own page under /mails/; a srcdoc frame
// resolves them against the story's page. Each becomes a path from the root: Chrome fetched a
// root-relative <base href> against the story's page first, a 404 beside every working image.
const page = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}mails/`, "http://catalog");
const framed = html.replace(
  /\b(src|href)="(?![a-z][a-z\d+.-]*:|[/#])([^"]*)"/gi,
  (_, name, url) => `${name}="${new URL(url, page).href.slice(page.origin.length)}"`,
);
---

<iframe
  title="Mail"
  srcdoc={framed}
  width={width}
  style={`width:${width}px;height:900px;border:1px solid var(--color-border)`}
  onload="this.style.height = this.contentDocument.documentElement.scrollHeight + 2 + 'px'"
></iframe>
