---
// One rendered mail in a frame at a reading-pane width, grown to the mail's height.
interface Props {
  html: string;
  width: number;
}
const { html, width } = Astro.props;
// A srcdoc frame resolves relative URLs against the story's page; a mail's data names its images
// relative to the mail's own page under /mails/.
const base = `<base href="${import.meta.env.BASE_URL.replace(/\/?$/, "/")}mails/">`;
const framed = html.replace(/<head[^>]*>/, (head) => head + base);
if (framed === html) throw new Error("MailFrame: the mail has no <head> to carry its <base>");
---

<iframe
  title="Mail"
  srcdoc={framed}
  width={width}
  style={`width:${width}px;height:900px;border:1px solid var(--color-border)`}
  onload="this.style.height = this.contentDocument.documentElement.scrollHeight + 2 + 'px'"
></iframe>
