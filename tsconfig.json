{
  "extends": "@hackersandwizards/scaffolding/tsconfig/astro.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun", "astro/client"]
  },
  "include": [
    "components",
    "mails",
    "scripts",
    "catalog",
    "test",
    "*.ts",
    "catalog/.astro/types.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
