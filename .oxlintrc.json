{
  "extends": ["./node_modules/@hackersandwizards/scaffolding/config/oxlint.json"],
  "plugins": ["typescript"],
  "env": { "browser": true, "node": true, "bun": true },
  "options": { "typeAware": true },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "**/dist/**",
    "**/.astro/**",
    "/.claude/**",
    "/.agents/**",
    "/.githooks/**"
  ],
  "overrides": [
    {
      "files": ["components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\./)*(\\.\\./)+(mails|scripts|catalog)(/|$)|^@hackersandwizards/mail/(mails/|render$)",
                "message": "Mail components cannot import mail compositions, scripts or catalog code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["mails/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\./)*(\\.\\./)+(scripts|catalog)(/|$)|^@hackersandwizards/mail/render$",
                "message": "Mail compositions cannot import scripts or catalog code."
              }
            ]
          }
        ]
      }
    }
  ]
}
